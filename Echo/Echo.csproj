<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<AssemblyName>Echo</AssemblyName>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<TargetFramework>net10.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<Version>0.0.0.1</Version>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Echo.Core">
			<HintPath>..\Dependencies\Echo.Core.dll</HintPath>
		</Reference>
		<Reference Include="Echo.Wire">
			<HintPath>..\Dependencies\Echo.Wire.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>